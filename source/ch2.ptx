<table xml:id="table-estimating-sir">
          <title />
          <tabular>
            <row header="yes">
              <cell halign="center">
                <m>\Delta t</m>
              </cell>
	<cell halign="center">
                <m>S(1)</m>
              </cell>
	<cell halign="center">new <m>S(0)</m>
              </cell>
	<cell halign="center">discrepancy</cell>
            </row>
<row>
              <cell halign="left">1.0</cell>
              <cell halign="left">44 446.6</cell>
              <cell halign="left">45 737.0626</cell>
              <cell halign="right">337.0626</cell>
            </row><row>
              <cell halign="left">0.1</cell>
              <cell halign="left">44 278.6648</cell>
              <cell halign="left">45 433.4741</cell>
              <cell halign="right">33.4741</cell>
            </row><row>
              <cell halign="left">0.01</cell>
              <cell halign="left">44 257.8301</cell>
              <cell halign="left">45 403.3615</cell>
              <cell halign="right">3.3615</cell>
            </row><row>
              <cell halign="left">0.001</cell>
              <cell halign="left">44 255.6960</cell>
              <cell halign="left">45 400.3363</cell>
              <cell halign="right">.3363</cell>
            </row><row>
